# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Web OAuth 2.0 Client ID from Firebase / Google Cloud Console
# used by Credential Manager (GetGoogleIdOption) for Google Sign-In.
# Configure this in the AI Studio Secrets panel or via google-services.json.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# FIREBASE_API_KEY: Firebase Android API key for project zaldi-25092026.
# Enter your key in the AI Studio Secrets panel.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY


